# OpenRouter or OpenCode Configuration
# Set your base URL to bypass Anthropic login and use custom models
ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
# Or for OpenCode Go: https://opencode.ai/zen/go
ANTHROPIC_API_KEY=sk-or-v1-your-key-here

# Custom model
# OpenRouter format: model-name (e.g., claude-3.5-sonnet)
# OpenCode Go format: kimi-k2.5, minimax-m2.7
ANTHROPIC_MODEL=claude-3.5-sonnet
